# www.liaoym.cloud —— 漏洞管理平台（scaffold 版，2026-10-12 替换 RuoYi 版）
# 旧版备份：/etc/nginx/conf.d/ruoyi-vuln.conf.bak-1012（回滚：还原本文件 + systemctl start ruoyi-vuln）
server {
    listen 443 ssl default_server;
    server_name  www.liaoym.cloud;
    ssl_certificate     /etc/letsencrypt/live/liaoym.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/liaoym.cloud/privkey.pem;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    root   /var/www/vuln;
    index  index.html;
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 4;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_vary on;

    # 上传文件大小限制
    client_max_body_size 20m;

    # 前端路由（history 模式）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反向代理：/api/ 原样透传到 6061（Controller 自带 /api 前缀）
    location /api/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 60s;
        proxy_pass http://127.0.0.1:6061;
    }

    # 旧 RuoYi 版路径全部废弃
    location ^~ /prod-api/ { return 404; }
    location ^~ /profile/  { return 404; }
}

# HTTP -> HTTPS 自动跳转
server {
    listen 80;
    server_name www.liaoym.cloud;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
